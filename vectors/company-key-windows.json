{
  "schemaVersion": 1,
  "frozen": true,
  "description": "The company key's window on its domain, judged at the instant the key signed (companyKeyOf(domainHash, sha256(raw Ed25519 key)) -> validFrom, anchoredAt, retiredAt, voidedAt), as the web verifier judges it. windows: record (null = unreadable) at G (null = no signing instant) under clock (anchoredAt: the consent anchor that holds the receipt's trusted root, issuerDatedOnly: no such anchor, the date is the issuer's own; both null/false = a chain instant, an epoch). expect.window is the window an authentic key was in force over. receiptClock: the clock a receipt's consent anchor gives. statusOf: the companyKeyRegistry check status of each verdict. LAG 259200 and SKEW 300 seconds. All integers travel as decimal strings.",
  "windows": [
    {
      "name": "k1 in force inside its window",
      "record": {
        "validFrom": "1000",
        "anchoredAt": "1010",
        "retiredAt": "2000",
        "voidedAt": "0"
      },
      "G": "1500",
      "clock": {
        "anchoredAt": null,
        "issuerDatedOnly": false
      },
      "expect": {
        "verdict": "authentic",
        "notYetEffective": false,
        "window": {
          "validFrom": "1000",
          "retiredAt": "2000"
        }
      }
    },
